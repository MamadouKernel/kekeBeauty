@page "/salons/{Id:long}"
@using KekeBeauty.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CatalogService Catalog
<PageTitle>@(salon?.Name ?? "Établissement") — Keke Beauty</PageTitle>
@if (salon is null) { <h1>Établissement indisponible</h1><a href="/">Revenir aux salons</a> }
else
{
    <h1>@salon.Name</h1><p>@salon.Location</p><p>@salon.Description</p>
    @if (salon.Phone.Length>0) { <a href="@($"tel:{salon.Phone}")">Appeler le salon</a> }
    <h2>Demander un rendez-vous</h2>
    <p>Sélectionnez vos prestations dans l’ordre affiché. Les soins se suivent ; le salon doit accepter votre demande. Paiement sur place.</p>
    @if (Error is not null) { <p role="alert">Ce créneau n’a pas pu être réservé. Vérifiez la date, les prestations et la disponibilité du salon.</p> }
    <AuthorizeView>
        <Authorized>
            <form method="post" action="/rendez-vous/creer" data-enhance="false" class="auth-card">
                <AntiforgeryToken /><input type="hidden" name="salon" value="@Id" /><input type="hidden" name="key" value="@Guid.NewGuid()" />
                <fieldset><legend>Prestations</legend>
                    @foreach(var option in options) { <label><input type="checkbox" name="versions" value="@option.Id" /> @option.Name · @option.Minutes min · @option.Price.ToString("N0") @option.Currency</label> }
                </fieldset>
                <label for="start">Date et heure du salon (@salon.TimeZone)</label>
                <input type="datetime-local" name="start" id="start" required />
                <button class="btn btn-primary">Demander ce rendez-vous</button>
            </form>
        </Authorized>
        <NotAuthorized><p><a href="/connexion">Connectez-vous</a> pour réserver.</p></NotAuthorized>
    </AuthorizeView>
}
@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery(Name="erreur")] public string? Error { get; set; }
    private Salon? salon; private List<ServiceOption> options=[];
    protected override async Task OnParametersSetAsync()
    {
        salon=(await Catalog.Search(id:Id)).FirstOrDefault();
        if(salon is not null) options=await Catalog.Services(Id);
    }
}
