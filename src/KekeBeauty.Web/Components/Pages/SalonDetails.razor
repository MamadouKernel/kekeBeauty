@page "/salons/{Id:long}"
@using KekeBeauty.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CatalogService Catalog
@inject MapsLinkService Maps
<PageTitle>@(salon?.Name ?? "Établissement") — Keke Beauty</PageTitle>
@if (salon is null) { <h1>Établissement indisponible</h1><a href="/">Revenir aux salons</a> }
else
{
    <h1>@salon.Name</h1><p>@salon.Location</p><p>@salon.Description</p>
    @if (salon.Phone.Length>0) { <a href="@($"tel:{salon.Phone}")">Appeler le salon</a> }
    @if (directions is not null) { <a href="@directions" target="_blank" rel="noopener noreferrer">S'y rendre</a> }
    <h2>Demander un rendez-vous</h2>
    <p>Sélectionnez vos prestations, puis affichez les créneaux proposés. Le salon doit accepter votre demande. Paiement sur place.</p>
    @if (Error is not null) { <p role="alert">Ce créneau n’a pas pu être réservé. Vérifiez la date, les prestations et la disponibilité du salon.</p> }
    <AuthorizeView>
        <Authorized>
            <form method="get" action="@($"/salons/{Id}")" class="auth-card">
                <fieldset><legend>Prestations</legend>
                    @foreach(var option in options) { <label><input type="checkbox" name="prestation" value="@option.Id" checked="@SelectedServices.Contains(option.Id)" /> @option.Name · @option.Minutes min · @option.Price.ToString("N0") @option.Currency</label> }
                </fieldset>
                <button class="btn btn-primary">Afficher les créneaux</button>
            </form>
            @if (SelectedServices.Length > 0)
            {
                @if (slots.Count == 0) { <p role="status">Aucun créneau automatique disponible pour cette sélection. Contactez l’établissement ou modifiez les prestations.</p> }
                else
                {
                    <form method="post" action="/rendez-vous/creer" data-enhance="false" class="auth-card">
                        <AntiforgeryToken /><input type="hidden" name="salon" value="@Id" /><input type="hidden" name="key" value="@Guid.NewGuid()" />
                        @foreach (var version in SelectedServices) { <input type="hidden" name="versions" value="@version" /> }
                        <fieldset><legend>Créneaux disponibles (@salon.TimeZone)</legend>
                            @foreach (var slot in slots) { <label><input type="radio" name="start" value="@slot.LocalStart.ToString("yyyy-MM-ddTHH:mm")" required /> @slot.LocalStart.ToString("dddd dd MMMM · HH:mm", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</label> }
                        </fieldset>
                        <button class="btn btn-primary">Demander ce rendez-vous</button>
                    </form>
                }
            }
        </Authorized>
        <NotAuthorized><p><a href="/connexion">Connectez-vous</a> pour réserver.</p></NotAuthorized>
    </AuthorizeView>
}
@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery(Name="erreur")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name="prestation")] public long[] SelectedServices { get; set; } = [];
    private Salon? salon; private List<ServiceOption> options=[]; private List<AvailableSlot> slots=[]; private string? directions;
    protected override async Task OnParametersSetAsync()
    {
        salon=(await Catalog.Search(id:Id)).FirstOrDefault();
        if(salon is not null)
        {
            options=await Catalog.Services(Id); directions=Maps.Directions(salon.Latitude,salon.Longitude);
            var allowed=options.Select(x=>x.Id).ToHashSet(); SelectedServices=SelectedServices.Where(allowed.Contains).Distinct().Take(10).ToArray();
            if(SelectedServices.Length>0) slots=await Catalog.AvailableSlots(Id,SelectedServices);
        }
    }
}
