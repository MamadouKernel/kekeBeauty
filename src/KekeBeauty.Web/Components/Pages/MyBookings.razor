@page "/mes-rendez-vous"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using KekeBeauty.Web.Services
@inject BookingService Bookings
<PageTitle>Mes rendez-vous — Keke Beauty</PageTitle>
<h1>Mes rendez-vous</h1>
@if (account is null)
{
    <p><a href="/connexion">Connectez-vous</a> pour consulter vos rendez-vous.</p>
}
else
{
    @if (Message is not null) { <p role="status">@(Message == "ok" ? "Le rendez-vous a été mis à jour." : "Action impossible : vérifiez vos droits, le délai, l’abonnement et la disponibilité du créneau.")</p> }
    <section aria-labelledby="notifications-title">
        <h2 id="notifications-title">Notifications</h2>
        @if (notifications.Count == 0) { <p>Aucune notification pour le moment.</p> }
        else
        {
            <ul class="kb-notifications">
                @foreach (var notification in notifications)
                {
                    <li><strong>@NotificationLabel(notification.Kind)</strong> · @notification.OccurredAt.ToString("dd/MM/yyyy HH:mm") UTC
                        @if (!string.IsNullOrWhiteSpace(notification.Reason)) { <span> — @notification.Reason</span> }
                    </li>
                }
            </ul>
        }
    </section>
    <h2>Demandes et rendez-vous</h2>
    @if (rows.Count == 0) { <p>Aucun rendez-vous pour le moment.</p> }
    <p>Les horaires ci-dessous sont affichés en UTC (heure d’Abidjan).</p>
    @foreach (var booking in rows)
    {
        <article class="auth-card">
            <h2>@booking.Salon</h2>
            <p>@booking.Start?.ToString("dd/MM/yyyy HH:mm") · @Label(booking.State)</p>
            @if (booking.CanDecide && booking.State == "en_attente_salon")
            {
                <form method="post" action="/rendez-vous/action" data-enhance="false">
                    <AntiforgeryToken /><input type="hidden" name="id" value="@booking.Id" />
                    <label>Motif du refus (facultatif)<textarea name="motif" maxlength="1000"></textarea></label>
                    <button name="action" value="accepter" class="btn btn-primary">Accepter</button>
                    <button name="action" value="refuser" class="btn btn-outline-danger">Refuser</button>
                </form>
            }
            @if (booking.IsClient && booking.State is "en_attente_salon" or "accepte")
            {
                <form method="post" action="/rendez-vous/action" data-enhance="false">
                    <AntiforgeryToken /><input type="hidden" name="id" value="@booking.Id" />
                    <input type="hidden" name="key" value="@Guid.NewGuid()" />
                    <button name="action" value="annuler" class="btn btn-outline-danger">Annuler ce rendez-vous</button>
                </form>
            }
        </article>
    }
    <form method="post" action="/auth/logout" data-enhance="false"><AntiforgeryToken /><button class="btn btn-secondary">Me déconnecter</button></form>
}
@code {
    [CascadingParameter] private Task<AuthenticationState> Authentication { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "resultat")] public string? Message { get; set; }
    private long? account;
    private List<Booking> rows = [];
    private List<BookingNotification> notifications = [];
    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication;
        if (long.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
        { account = id; rows = await Bookings.List(id); notifications = await Bookings.Notifications(id); }
    }
    private static string Label(string state) => state switch { "en_attente_salon"=>"En attente du salon", "accepte"=>"Accepté", "refuse"=>"Refusé", "annule"=>"Annulé", "expire"=>"Expiré", "termine"=>"Terminé", "absent"=>"Absent", _=>state };
    private static string NotificationLabel(string kind) => kind switch { "acceptation"=>"Rendez-vous accepté", "refus"=>"Rendez-vous refusé", "annulation"=>"Rendez-vous annulé", "report"=>"Rendez-vous reprogrammé", _=>"Mise à jour du rendez-vous" };
}
