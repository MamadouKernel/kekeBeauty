@page "/"
@using KekeBeauty.Web.Services
@inject CatalogService Catalog
<PageTitle>Keke Beauty — Votre rendez-vous beauté</PageTitle>
<section class="kb-hero">
    <p class="kb-eyebrow">Votre beauté, votre rendez-vous</p>
    <h1>Trouvez votre prochain salon</h1>
    <p>Découvrez les prestations et demandez un rendez-vous. Le salon confirme votre demande ; vous payez sur place.</p>
    <form method="get" action="/">
        <label for="search">Salon ou commune</label>
        <input id="search" name="q" value="@Query" maxlength="120" placeholder="Nom du salon, commune…" />
        <label for="category">Catégorie</label>
        <select id="category" name="categorie">
            <option value="">Toutes les catégories</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(Category == category.Id)">@category.Name</option>
            }
        </select>
        <button class="btn btn-primary">Rechercher</button>
        <a href="/">Réinitialiser</a>
    </form>
</section>
<section class="kb-section">
    <h2>Les établissements</h2>
    @if (salons.Count == 0) { <p>Aucun établissement ne correspond à votre recherche pour le moment.</p> }
    @foreach (var salon in salons)
    {
        <article class="kb-card"><h3>@salon.Name</h3><p>@salon.Location</p><p>@salon.Description</p><a href="@($"salons/{salon.Id}")">Prestations et réservation</a></article>
    }
</section>
@code {
    [SupplyParameterFromQuery(Name="q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name="categorie")] public long? Category { get; set; }
    private List<Salon> salons=[];
    private List<CategoryOption> categories=[];
    protected override async Task OnParametersSetAsync()
    {
        categories = await Catalog.Categories();
        salons = await Catalog.Search(Query??"", category: Category);
    }
}
